# Copy to .env before running `docker compose up`.
# Compose reads this file automatically and interpolates it into
# docker-compose.yml, so the signing key never has to live in the yaml.
#
# Generate a fresh secret per environment:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-generated-secret
JWT_EXPIRES_IN=1h

# Service account for the uptime-checker container. Create it via
# POST /auth/register (ADMIN-only) or the Users > New user page in the
# console, with the ANALYST role — POST /alerts requires ANALYST or above.
UPTIME_CHECKER_USERNAME=uptime-checker
UPTIME_CHECKER_PASSWORD=replace-me-with-a-generated-password
# No target list here: the checker polls GET /assets and monitors every
# Asset that has its monitoredUrl field set. To watch a site, set
# monitoredUrl on its Asset record (New asset form, or PATCH /assets/:id)
# — no .env change or redeploy needed to add/remove a site.
